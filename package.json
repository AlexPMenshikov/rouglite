{
  "name": "rouglite",
  "version": "1.0.0",
  "private": true,
  "description": "Browser roguelite with LAN co-op hosting",
  "scripts": {
    "start": "node server.js",
    "lint": "node scripts/check-syntax.js",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:coverage": "node --experimental-test-coverage --test \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
